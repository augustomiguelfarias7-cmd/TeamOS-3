<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher principal TeamOS 3.0 - Android 16 + One UI 8 -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/teamos_background">

    <!-- Conteúdo da home -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/home_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Status bar fake -->
        <LinearLayout
            android:id="@+id/status_bar"
            android:layout_width="0dp"
            android:layout_height="@dimen/teamos_status_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/status_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="12:00"
                android:textColor="@color/teamos_on_surface"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="85%"
                android:textColor="@color/teamos_on_surface"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:layout_marginStart="24dp"
            android:text="12:00"
            android:textColor="@color/teamos_on_surface"
            android:textSize="64sp"
            android:fontFamily="sans-serif-light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/status_bar" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Domingo, 26 de julho"
            android:textColor="@color/teamos_on_surface_variant"
            android:textSize="15sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clock" />

        <!-- Grade de apps -->
        <GridLayout
            android:id="@+id/apps_grid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            android:columnCount="4"
            android:alignmentMode="alignMargins"
            app:layout_constraintBottom_toTopOf="@id/dock"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <!-- Apps preenchidos via código ou includes -->
        </GridLayout>

        <!-- Dock estilo One UI -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dock"
            android:layout_width="0dp"
            android:layout_height="@dimen/teamos_dock_height"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#990F172A"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp" android:src="@android:drawable/ic_menu_call" app:tint="@color/teamos_on_surface" />
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp" android:src="@android:drawable/ic_dialog_email" app:tint="@color/teamos_on_surface" />
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp" android:src="@android:drawable/ic_menu_compass" app:tint="@color/teamos_on_surface" />
                <ImageView android:layout_width="48dp" android:layout_height="48dp" android:layout_margin="8dp" android:src="@android:drawable/ic_menu_camera" app:tint="@color/teamos_on_surface" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Quick Settings Panel (desliza do topo) -->
    <include
        android:id="@+id/quick_settings"
        layout="@layout/panel_quick_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:visibility="gone" />

</FrameLayout>
