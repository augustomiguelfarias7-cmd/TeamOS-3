<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme -->
    <style name="Theme.AeroLauncher" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Show system wallpaper behind launcher -->
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>

        <!-- Status and Navigation bars -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>

        <!-- Accent/Primary settings -->
        <item name="colorPrimary">@color/cyan_neon</item>
        <item name="colorPrimaryDark">@color/dark_bg</item>
        <item name="colorAccent">@color/purple_neon</item>
    </style>

    <!-- Settings theme with a standard solid background -->
    <style name="Theme.AeroLauncher.Settings" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyan_neon</item>
        <item name="colorAccent">@color/purple_neon</item>
    </style>
</resources>
