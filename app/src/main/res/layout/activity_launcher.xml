<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LauncherActivity">

    <!-- Top Status / Settings Header Bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/teamos_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="TeamOS 3.0"
            android:textColor="#8C99B0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15" />

        <ImageView
            android:id="@+id/btn_settings"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_settings"
            android:contentDescription="@string/settings_name"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@color/cyan_neon" />
    </LinearLayout>

    <!-- Workspace View (Holds screens and widgets) -->
    <com.teamos.launcher.Workspace
        android:id="@+id/workspace"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintBottom_toTopOf="@id/hotseat_card" />

    <!-- Page Indicator -->
    <LinearLayout
        android:id="@+id/page_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@id/hotseat_card"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Hotseat Dock at the bottom (Glass Card) -->
    <androidx.cardview.widget.CardView
        android:id="@+id/hotseat_card"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_margin="16dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#C0121620"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/hotseat_apps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </androidx.cardview.widget.CardView>

    <!-- Swipe Indicator / Drag Hint for App Drawer -->
    <TextView
        android:id="@+id/swipe_up_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="▲ Deslize para subir a gaveta"
        android:textColor="#50FFFFFF"
        android:textSize="10sp"
        android:layout_marginBottom="2dp"
        app:layout_constraintBottom_toTopOf="@id/hotseat_card"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- sliding All Apps Drawer (Starts invisible, animated upward) -->
    <FrameLayout
        android:id="@+id/all_apps_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E8070A0F"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginTop="40dp">

            <!-- Drag down line to close -->
            <View
                android:id="@+id/btn_close_drawer"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="#4DFFFFFF"
                android:layout_marginBottom="16dp" />

            <!-- Cyber glass search bar with ChatGusto button -->
            <LinearLayout
                android:id="@+id/search_bar_container"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:orientation="horizontal"
                android:background="@drawable/bg_glass_card_dark"
                android:gravity="center_vertical"
                android:paddingLeft="16dp"
                android:paddingRight="8dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search"
                    android:tint="@color/dark_text_secondary" />

                <EditText
                    android:id="@+id/search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_hint"
                    android:textColor="@color/dark_text_primary"
                    android:textColorHint="#4DFFFFFF"
                    android:textSize="14sp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <!-- ChatGusto Virtual Assistant Button -->
                <ImageView
                    android:id="@+id/btn_chatgusto"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_chatgusto"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp"
                    android:tint="@color/cyan_neon" />
            </LinearLayout>

            <!-- Apps Recycler View -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/apps_recycler"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="48dp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
